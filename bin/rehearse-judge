assert 'WebSearch' not in allow, allow"
(cd "$T/stubcell" && printf '{"id":"a-4","of":"w-l","what":"prove it"}' | PATH="$T/stub:$PATH" OSTOYAE_ATTEMPT=a-4 OSTOYAE_WORK=w-l bash "$OST/executors/claude.sh" > "$T/stub4.log" 2>&1)
assert "9. and passes no --mcp-config when the operator has not named one" "
