printf '#!/usr/bin/env bash\ntrue\n' > "$T/stub/lean-mcp" && chmod +x "$T/stub/lean-mcp"
(cd "$T/stubcell" && printf '{"id":"a-3","of":"w-l","what":"prove it"}' | PATH="$T/stub:$PATH" OSTOYAE_ATTEMPT=a-3 OSTOYAE_WORK=w-l OSTOYAE_WORKTREE="$T/stubcell" OSTOYAE_LEAN_MCP="$T/stub/lean-mcp" bash "$OST/executors/claude.sh" > "$T/stub3.log" 2>&1)
assert "9. claude.sh gives the cell the Lean language server, pointed at its own worktree, closed by the next flag" "
