(cd "$T/stubcell" && printf '{"id":"a-2","of":"w-l","what":"grep it"}' | PATH="$T/stub:$PATH" OSTOYAE_ATTEMPT=a-2 OSTOYAE_WORK=w-l bash "$OST/executors/claude.sh" > "$T/stub2.log" 2>&1)
assert "9. and passes no --add-dir when nothing is linked" "
assert '--add-dir' not in open('$T/argv.txt').read().split('\n')"

echo "== run 8: the unattended yes and a route that is already closed"
# A route the operator has already closed is not a destination. `confirmScoped` built its set of
# pre-existing work by excluding proposals only, so a rejected item still counted as a ticket and
# a proposal whose one edge reached it passed the scope gate unattended — the walk reporting
# "reaches a ticket" about work that was closed as false. w-open is the control: an ordinary
# ticket, and the proposal that reaches it must still be confirmed, because this is a scope rule
# and not a switch that stops saying yes.
python3 - "$T" <<'PY'
import json, sys
T = sys.argv[1]
g = {"graph": "rehearse-closed", "concurrency": 1, "max_attempts": 1,
     "sandbox": {"repo": f"{T}/pursuit", "root": f"{T}/wt-closed", "base": "main", "port_base": 4960},
     "work": [
       {"id": "w-open", "what": "an open ticket"},
       {"id": "w-closed", "what": "a statement proved false", "status": "rejected",
        "decided_at": "2026-09-08", "rejected_why": "disproved in Lean by a-0007"},
       {"id": "w-to-closed", "what": "a lemma the closed statement needed", "status": "proposed"},
       {"id": "w-via-closed", "what": "a lemma that lemma needed", "status": "proposed"},
       {"id": "w-to-open", "what": "a lemma the open ticket needs", "status": "proposed"},
     ],
     "edges": [
       {"id": "e-0001", "from": "w-to-closed",  "to": "w-closed",     "status": "proposed", "why": "it needed it"},
       {"id": "e-0002", "from": "w-via-closed", "to": "w-to-closed",  "status": "proposed", "why": "one step further out"},
       {"id": "e-0003", "from": "w-to-open",    "to": "w-open",       "status": "proposed", "why": "the open ticket needs it"},
     ],
     "attempts": []}
json.dump(g, open(f"{T}/closed.json", "w"), indent=2)
PY
C="$T/closed.json"
node run.mjs "$C" --confirm-scoped > "$T/run8.log" 2>&1
echo "  exit $?"
assert "10. a proposal whose only route is a closed statement is left for the operator" "
import json;g=json.load(open('$C'))
w={x['id']:x for x in g['work']}; e={x['id']:x for x in g['edges']}
assert w['w-to-closed']['status']=='proposed', w['w-to-closed']
assert e['e-0001']['status']=='proposed', e['e-0001']
assert 'decided_at' not in w['w-to-closed'], w['w-to-closed']"
assert "10. and so is one that reaches it only through another proposal" "
import json;g=json.load(open('$C'))
w={x['id']:x for x in g['work']}; e={x['id']:x for x in g['edges']}
assert w['w-via-closed']['status']=='proposed', w['w-via-closed']
assert e['e-0002']['status']=='proposed', e['e-0002']"
assert "10. the closed statement is left closed: this decides nothing on the operator's behalf" "
import json;g=json.load(open('$C'))
w={x['id']:x for x in g['work']}
assert w['w-closed']['status']=='rejected' and w['w-closed']['decided_at']=='2026-09-08', w['w-closed']
assert w['w-closed']['rejected_why']=='disproved in Lean by a-0007', w['w-closed']
assert w['w-open'].get('status','active')=='active', w['w-open']"
assert "10. a proposal that reaches open work is still confirmed, and the count says two left" "
import json;g=json.load(open('$C'))
w={x['id']:x for x in g['work']}; e={x['id']:x for x in g['edges']}
assert w['w-to-open']['status']=='active', w['w-to-open']
assert e['e-0003']['status']=='confirmed', e['e-0003']
log=open('$T/run8.log').read()
assert '2 changed' in log, log
assert '4 proposal(s) left for the operator' in log and 'reach no ticket' in log, log"
assert "10. and --confirm by id is still the way a person says yes to one of them" "
import json,subprocess
subprocess.run(['node','run.mjs','$C','--confirm','w-to-closed,e-0001'],capture_output=True)
g=json.load(open('$C'))
w={x['id']:x for x in g['work']}; e={x['id']:x for x in g['edges']}
assert w['w-to-closed']['status']=='active' and e['e-0001']['status']=='confirmed', (w['w-to-closed'], e['e-0001'])"

echo "== run 11: a judged discovery holds its source only through a live path (tinygrad A/B)"
# #11756's mapper found a real side bug with no edge to its source; #5360's edge was
# refuted by the judge. Both sources stayed parked on proposals no one could answer
# unattended. The runner and the viewer share derive(), so these states are both.
node --input-type=module > "$T/run11.log" 2>&1 <<'JS'
import { derive } from "./viewer/state.mjs";
let fails = 0;
const check = (n, c) => { console.log((c ? "  ok    " : "  FAIL  ") + n); if (!c) fails++; };
const att = (id, of, kind, state, result) => ({ id, of, kind, state, result });
// #11756: judged-ok side discovery, no edge.
let g = { mapping: { what: "m" }, judge: { verify: "j" }, max_attempts: 2,
  work: [{ id: "w-s", what: "source" },
    { id: "w-side", what: "side bug", status: "proposed", found_by: ["a-1"], verdict: { ok: true } }],
  edges: [], attempts: [att("a-1", "w-s", "map", "done",
    { map: { settles: "x", cost: "small" }, found: ["w-side"] })] };
let S = derive(g);
check("11. judged-ok side work with no edge does not park its source", S.stateOf("w-s") === "ready");
check("11. the side discovery stays proposed for review", S.stateOf("w-side") === "proposed");
// #5360: judged-ok work, refuted edge.
g = { mapping: { what: "m" }, judge: { verify: "j" }, max_attempts: 2,
  work: [{ id: "w-s", what: "source" },
    { id: "w-need", what: "need", status: "proposed", found_by: ["a-1"], verdict: { ok: true } }],
  edges: [{ id: "e-0001", from: "w-need", to: "w-s", why: "claimed", status: "proposed",
    found_by: ["a-1"], verdict: { ok: false } }],
  attempts: [att("a-1", "w-s", "map", "done",
    { map: { settles: "x", cost: "small" }, found: ["w-need", "e-0001"] })] };
S = derive(g);
check("11. a refuted edge does not park its source", S.stateOf("w-s") === "ready");
check("11. need and refuted edge stay proposed", S.lookup("w-need").status === "proposed" &&
  S.lookup("e-0001").status === "proposed");
// Indirect: judged-ok work reaching the source only through a refuted edge does not hold.
g.edges.push({ id: "e-0002", from: "w-far", to: "w-need", why: "chain", status: "proposed",
  found_by: ["a-1"], verdict: { ok: true } });
g.work.push({ id: "w-far", what: "far", status: "proposed", found_by: ["a-1"], verdict: { ok: true } });
g.attempts[0].result.found.push("w-far", "e-0002");
S = derive(g);
check("11. an indirect path through a refuted edge does not park", S.stateOf("w-s") === "ready");
g.edges[0].verdict = { ok: true };
S = derive(g);
check("11. an indirect live path still parks", S.stateOf("w-s") === "mapped");
// Preserved: unjudged proposals, refuted work, and real prerequisites still hold.
g = { max_attempts: 2,
  work: [{ id: "w-u", what: "walled" },
    { id: "w-u-need", what: "claimed need", status: "proposed", found_by: ["a-1"] }],
  edges: [{ id: "e-9", from: "w-u-need", to: "w-u", why: "u needs it", status: "proposed", found_by: ["a-1"] }],
  attempts: [att("a-1", "w-u", "prove", "walled", { wall: "blocked", found: ["w-u-need", "e-9"] })] };
S = derive(g);
check("11. an unjudged wall dependency still parks", S.stateOf("w-u") === "walled");
g.edges = [];
g.attempts[0].result.found = ["w-u-need"];
g.work[1].verdict = { ok: false };
S = derive(g);
check("11. refuted work still parks until the operator closes it", S.stateOf("w-u") === "walled");
g = { max_attempts: 2,
  work: [{ id: "w-c", what: "shared prerequisite" }, { id: "w-a", what: "one" }, { id: "w-b", what: "two" }],
  edges: [{ id: "e-1", from: "w-c", to: "w-a", status: "confirmed", why: "a needs c" },
    { id: "e-2", from: "w-c", to: "w-b", status: "confirmed", why: "b needs c" }],
  attempts: [] };
S = derive(g);
check("11. a shared prerequisite holds two dependents while open",
  S.stateOf("w-a") === "waiting" && S.stateOf("w-b") === "waiting");
g.attempts.push(att("a-1", "w-c", "prove", "done", {}));
S = derive(g);
check("11. both proceed once it completes", S.readyIds().has("w-a") && S.readyIds().has("w-b"));
process.exit(fails ? 1 : 0);
JS
if [ "$?" = 0 ]; then pass "11. all parking states read as decided"; else fail "11. parking states"; tail -5 "$T/run11.log" | sed 's/^/        /'; fi

echo "== run 12: the unattended run proves through judged discoveries"
python3 - "$T" <<'PY'
import json, sys
T = sys.argv[1]
g = {"graph": "rehearse-park", "concurrency": 1, "max_attempts": 1,
     "mapping": {"what": "map it", "max_attempts": 1},
     "judge": {"verify": "judge it: is each blocker real"},
     "sandbox": {"repo": f"{T}/pursuit", "root": f"{T}/wt-park", "base": "main", "port_base": 4970},
     "work": [
       {"id": "w-side", "what": "the side ticket", "params": {"fake": {"map": {
         "map": {"settles": "side lands", "cost": "small"},
         "work": [{"id": "w-side-note", "what": "a real side bug the mapper found"}],
         "edges": []}}}},
       {"id": "w-dep", "what": "the depended ticket", "params": {"fake": {"map": {
         "map": {"settles": "dep lands", "cost": "small"},
         "work": [{"id": "w-dep-need", "what": "a real bug that does not block dep"}],
         "edges": [{"from": "w-dep-need", "to": "w-dep", "why": "dep cannot be verified without it"}]},
         "verify": {"e-0001": "no: dep reproduces without it"}}}},
     ], "edges": [], "attempts": []}
json.dump(g, open(f"{T}/park.json", "w"), indent=2)
PY
P="$T/park.json"
node run.mjs "$P" --exec "bash $OST/executors/fake.sh" --auto-advance --max-launches 12 > "$T/run12.log" 2>&1
echo "  exit $?"
assert "12. both sources were proved after their maps were judged" "
import json;g=json.load(open('$P'))
ps={a['of']:a for a in g['attempts'] if a.get('kind','prove')=='prove'}
assert ps['w-side']['state']=='done' and ps['w-dep']['state']=='done', [(a['of'],a['state']) for a in g['attempts']]"
assert "12. the discoveries and the refuted edge stay proposed, nothing auto-confirmed" "
import json;g=json.load(open('$P'))
w={x['id']:x for x in g['work']}; e={x['id']:x for x in g['edges']}
assert w['w-side-note']['status']=='proposed' and w['w-dep-need']['status']=='proposed', w
assert len(e)==1, e
edge=list(e.values())[0]
assert edge['status']=='proposed' and edge['verdict']['ok'] is False, edge
assert not [x for x in list(w.values())+list(e.values()) if x.get('decided_via')=='auto-advance'], 'nothing was in scope to confirm'"
assert "12. the drain says discoveries await review, not that work is parked" "
import json;g=json.load(open('$P'))
assert g['last_run']['drained']=='awaiting-decision', g['last_run']"

echo
if [ "$fails" = 0 ]; then echo "  rehearsal passed"; else echo "  $fails assertion(s) failed; logs in $T (kept)"; trap - EXIT; exit 1; fi
